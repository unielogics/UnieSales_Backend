NODE_ENV=development
PORT=4000

# In production, leave these empty and set AWS_REGION + AWS_SECRET_ID below.
# The env loader will fetch from Secrets Manager via the EC2 instance role.

APP_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://uniesales_admin:CHANGE_ME@localhost:5432/uniesales

AWS_REGION=us-east-1
AWS_SECRET_ID=uniesales/prod/app
S3_BUCKET=uniesales-prod-files

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5
ANTHROPIC_MODEL_HEAVY=claude-sonnet-4-6

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

JWT_SECRET=CHANGE_ME_64_HEX_CHARS
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

AUTO_REPLY_DEFAULT=false
AUTO_REPLY_CONFIDENCE_THRESHOLD=0.85
DEFAULT_SEND_LIMIT_PER_INBOX=25

# Comma-separated CORS allowlist (no wildcards in prod)
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info
